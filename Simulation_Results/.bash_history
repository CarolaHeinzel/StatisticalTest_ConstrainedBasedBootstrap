#!/bin/bash
# Pfad zum STRUCTURE-Programm
STRUCTURE_PATH="/Pfad/zum/structure"
# Verzeichnis, in dem Ihre Daten liegen
DATA_DIR="/Pfad/zu/Ihren/Daten"
# Anzahl der Iterationen für STRUCTURE (passen Sie an)
NUM_ITERATIONS=10
# Schleife über die Daten-Dateien
for i in {1..10}; do
  DATA_FILE="$DATA_DIR/data$i.txt"  
  $STRUCTURE_PATH -i $DATA_FILE -K 3 --other_options  
done
